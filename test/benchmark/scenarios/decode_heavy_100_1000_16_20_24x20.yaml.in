load:
  type: poisson
  stages:
  - rate: 16
    duration: 300
  - rate: 20
    duration: 300
  - rate: 24
    duration: 1200
  request_timeout: 300
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
data:
  type: random
  input_distribution:
    min: 80
    max: 120
    mean: 100
    std_dev: 10
    total_count: 5000
  output_distribution:
    min: 800
    max: 1200
    mean: 1000
    std_dev: 100
    total_count: 5000
report:
  request_lifecycle:
    summary: true
    per_stage: true
    # per_request disabled: same OOM/multi-GB-JSON risk documented in
    # prefill_heavy_4k1k_2_4_6_8.yaml.in — output tokens here are 4x
    # prefill_heavy_1000_250's, so per-request payloads are comparably large.
    per_request: false
storage:
  local_storage:
    path: /workspace
